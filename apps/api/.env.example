# ── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/website_builder

# ── Redis ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=ai-builder:

# ── JWT (RS256) ─────────────────────────────────────
# Generate with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl pkey -in private.pem -pubout -out public.pem
# Then paste the contents as a single line, replacing actual newlines with \n
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----

# ── Cloudflare R2 (CDN) ─────────────────────────────
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=your-bucket-name
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── Cloudflare (DNS / Cache Purge) ──────────────────
CF_API_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-cloudflare-zone-id
CDN_CNAME_TARGET=your-cdn-cname-target.example.com
DOMAIN_VERIFICATION_SECRET=your-domain-verification-secret

# ── LLM Provider ────────────────────────────────────
# Set to "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -- Horizontal Scaling ------------------------------
# Each worker instance must have a unique REGION value.
# If present, BullMQ jobs carry a region tag and are
# rejected by workers in a different region.
REGION=us-east-1

# Worker concurrency per queue (how many jobs a single
# process picks simultaneously).
WORKER_CONCURRENCY_GENERATE=2
WORKER_CONCURRENCY_PUBLISH=2

# Stalled job detection � if a worker holding a lock
# disappears, another worker picks it up after this
# interval (ms).
WORKER_STALLED_INTERVAL=30000
WORKER_MAX_STALLED=1
